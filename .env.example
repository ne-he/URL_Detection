# Salin ke .env.local untuk pengembangan lokal. Semua opsional.

# Backend yang dipanggil UI. Kosongkan untuk memakai Space produksi repo ini
# (https://ne-he-phisguard-api.hf.space). Isi kalau mau menunjuk backend lokal:
# VITE_API_BASE=http://localhost:7860

# Feature flag UI. Set "false" untuk mematikan salah satunya (misal saat mengukur
# performa render di laptop tanpa GPU).
# VITE_FEATURE_SHADER=false
# VITE_FEATURE_GLOBE=false
# VITE_FEATURE_VOICE=false
# VITE_FEATURE_GAMIFICATION=false
